PORT=4000
LOG_LEVEL=info
CLIENT_URL=http://localhost:3000
DATABASE_URL="postgresql://user:REDACTED@host/dbname?sslmode=require"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Gmail SMTP (get app password from https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Stripe (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# OpenAI (AI assistant) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase Storage (file uploads) — https://supabase.com/dashboard
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_BUCKET=collabspace-attachments

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4000/collab
