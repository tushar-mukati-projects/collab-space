{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun prisma generate && bun tsc",
    "start": "bun src/index.ts",
    "collab": "bun src/collab-server.ts",
    "db:generate": "bun prisma generate",
    "db:migrate": "bun prisma migrate dev",
    "db:push": "bun prisma db push",
    "db:seed": "bun prisma/seed.ts",
    "db:studio": "bun prisma studio",
    "lint": "bun eslint",
    "typecheck": "bun tsc --noEmit",
    "format:check": "bun prettier --check \"src/**/*.ts\"",
    "format:fix": "bun prettier --write \"src/**/*.ts\"",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "check:fix": "bun run lint -- --fix && bun run format:fix && bun run typecheck"
  },
  "dependencies": {
    "@clerk/express": "^1.6.0",
    "@hocuspocus/extension-database": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@supabase/supabase-js": "^2.100.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-validator": "^7.3.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.1",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5",
    "typescript-eslint": "^8.57.1"
  }
}
